# EchoShelf 常规部署配置
# 安装脚本会按参数改写下面三项路径；之后可手工修改，改完重启服务生效

# ---------- 路径（安装脚本自动填） ----------
ECHOSHELF_DATA_PATH=/var/lib/echoshelf
ECHOSHELF_AUDIOBOOKS_PATH=/srv/audiobooks
ECHOSHELF_WEB_DIST_PATH=/opt/echoshelf/web/dist

# ---------- 网络 ----------
ECHOSHELF_HOST=0.0.0.0
ECHOSHELF_PORT=8080
# 放在 Nginx/Caddy 后面时保持 1，让日志与限流拿到真实 IP
# 直接对外暴露时建议用防火墙限制来源

# ---------- 行为 ----------
ECHOSHELF_LOG_LEVEL=info
ECHOSHELF_ALLOW_REGISTRATION=false
# 首个管理员密码；留空则首次访问走网页初始化（更安全）
ECHOSHELF_ADMIN_PASSWORD=

# 转码（wma/ape → opus/mp3）；性能弱的机器可关
ECHOSHELF_ENABLE_TRANSCODE=true
ECHOSHELF_TRANSCODE_MAX_BYTES=4294967296
ECHOSHELF_TRANSCODE_MAX_DURATION_SEC=7200

# 无章节音频的虚拟章节长度（分钟）
ECHOSHELF_SCAN_VIRTUAL_CHAPTER_MIN=15

# 按章节切片缓存（供客户端离线下载，WebUI 不使用）
ECHOSHELF_ENABLE_CHAPTER_CACHE=true
ECHOSHELF_CHAPTER_CACHE_MAX_BYTES=2147483648
