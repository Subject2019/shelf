# EchoShelf 环境变量模板 —— 复制为 .env 后修改
# cp deploy/.env.example deploy/.env

# ---------- 必改 ----------
# 媒体库在【宿主机】上的绝对路径（群晖一般是 /volume1/xxx，威联通 /share/xxx）
AUDIOBOOKS_PATH=/volume1/media/audiobooks

# 数据目录（数据库、密钥、封面缓存）。必须在本地盘，不要放 SMB/NFS
ECHOSHELF_DATA_PATH=./data

# ---------- 建议改 ----------
ECHOSHELF_PORT=8080
ECHOSHELF_TAG=latest
TZ=Asia/Shanghai

# 首个管理员。网页端已不提供初始化入口，必须在这里给密码，
# 或者启动后执行：docker exec -it shelf python -m app.cli admin create
# 仅在数据库里一个用户都没有时生效；之后修改不会覆盖已有密码。
ECHOSHELF_ADMIN_USERNAME=admin
ECHOSHELF_ADMIN_PASSWORD=
# 更安全：把密码写进文件（如 Docker secret），设置后优先于明文变量
ECHOSHELF_ADMIN_PASSWORD_FILE=
# true：每次启动同步上面的密码到管理员（适合「环境变量即事实来源」）
# 注意：开启后网页里改的密码会在下次重启时被环境变量覆盖
ECHOSHELF_ADMIN_SYNC_PASSWORD=false

# 是否允许自助注册（个人 NAS 建议 false）
ECHOSHELF_ALLOW_REGISTRATION=false

# ---------- 权限 ----------
# 容器进程 uid/gid，需对 AUDIOBOOKS_PATH 有读权限。
# 群晖常见 1000/1000；可用 `id` 命令查宿主当前用户
PUID=1000
PGID=1000

# ---------- 性能 ----------
ECHOSHELF_CPUS=2.0
ECHOSHELF_MEMORY=1g
ECHOSHELF_LOG_LEVEL=info

# 是否允许 ffmpeg 实时转码（弱 ARM NAS 建议 false，wma/ape 将无法播放）
ECHOSHELF_ENABLE_TRANSCODE=true

# 无章节音频的虚拟章节切分长度（分钟）
ECHOSHELF_SCAN_VIRTUAL_CHAPTER_MIN=15

# ---------- 按章节切片缓存（给安卓/第三方客户端离线下载用，WebUI 不使用） ----------
# 关闭后 /api/v1/books/{id}/chapters/{idx}/audio 返回 503
ECHOSHELF_ENABLE_CHAPTER_CACHE=true
# 切片缓存上限（字节），超过后按最旧优先清理；默认 2 GiB
ECHOSHELF_CHAPTER_CACHE_MAX_BYTES=2147483648
# 单次切片超时（秒）
ECHOSHELF_CHAPTER_SLICE_TIMEOUT=120

# ---------- 整轨转码（wma/ape 等浏览器不支持的格式，转成 opus/mp3） ----------
# 转码缓存上限（字节），默认 4 GiB，超出按最旧清理
ECHOSHELF_TRANSCODE_MAX_BYTES=4294967296
# 单次转码超时（秒）
ECHOSHELF_TRANSCODE_TIMEOUT=1800
# 单轨时长上限（秒），超过则返回 413 并提示改用按集切片；0 = 不限制
ECHOSHELF_TRANSCODE_MAX_DURATION_SEC=7200
