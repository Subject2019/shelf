#!/bin/bash
set -u

log() {
    printf '%s\n' "$*" >&2
}

# 应用数据目录；${TRIM_PKGVAR}/data 由容器实际使用。
if [ -n "${TRIM_PKGVAR:-}" ]; then
    mkdir -p "$TRIM_PKGVAR/data" "$TRIM_PKGVAR/media" 2>/dev/null || true
    {
        printf '%s install_callback: data dirs ready\n' "$(date '+%Y-%m-%d %H:%M:%S')"
        printf 'status=%s\n' "${TRIM_APP_STATUS:-unknown}"
        printf 'appdest=%s\n' "${TRIM_APPDEST:-}"
        printf 'pkgetc=%s\n' "${TRIM_PKGETC:-}"
        printf 'pkgvar=%s\n' "${TRIM_PKGVAR:-}"
        printf 'media_path=%s\n' "${wizard_media_path:-<share>}"
    } >> "$TRIM_PKGVAR/install.log" 2>/dev/null || true
fi

# 自定义媒体目录只做提示，不在安装阶段失败；Compose 会按 wizard_media_path 挂载。
if [ -n "${wizard_media_path:-}" ]; then
    if [ ! -d "$wizard_media_path" ]; then
        log "提示：媒体目录 $wizard_media_path 当前不存在，安装完成后请检查路径。"
    fi
fi

exit 0
