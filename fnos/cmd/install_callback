#!/bin/bash
set -euo pipefail

log() {
    printf '%s\n' "$*" >&2
    if [[ -n "${TRIM_TEMP_LOGFILE:-}" ]]; then
        printf '%s\n' "$*" >> "$TRIM_TEMP_LOGFILE"
    fi
}

fail() {
    log "声架安装失败：$*"
    exit 1
}

[[ -f "$TRIM_PKGETC/shelf.env" ]] || fail "缺少 $TRIM_PKGETC/shelf.env"
[[ -f "$TRIM_PKGETC/admin_password" ]] || fail "缺少管理员密码文件"

mkdir -p "$TRIM_PKGVAR/data"
# 未创建数据共享目录时使用的回退媒体目录。
mkdir -p "$TRIM_PKGVAR/media"

log "声架数据目录已就绪"
exit 0
